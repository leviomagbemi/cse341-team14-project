  "definitions": {
    "Shirt": {
      "type": "object",
      "properties": {
        "productName": {
          "type": "string",
          "example": "Classic Cotton Polo"
        },
        "sleeveLength": {
          "type": "string",
          "example": "Short"
        },
        "fabricType": {
          "type": "string",
          "example": "Cotton"
        },
        "fit": {
          "type": "string",
          "example": "Regular"
        },
        "color": {
          "type": "string",
          "example": "Navy Blue"
        },
        "price": {
          "type": "number",
          "example": 49.99
        },
        "size": {
          "type": "string",
          "example": "M"
        },
        "stockQuantity": {
          "type": "number",
          "example": 150
        },
        "supplierId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439012"
        },
        "categoryId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439014"
        }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "customerEmail": {
          "type": "string",
          "example": "customer@example.com"
        },
        "shirtId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011"
        },
        "quantity": {
          "type": "number",
          "example": 2
        },
        "status": {
          "type": "string",
          "example": "Pending"
        }
      }
    },
    "Category": {
      "type": "object",
      "properties": {
        "categoryName": {
          "type": "string",
          "example": "Summer Collection"
        },
        "description": {
          "type": "string",
          "example": "Light and breathable shirts for warm weather"
        },
        "season": {
          "type": "string",
          "example": "Summer"
        }
      }
    },
    "Supplier": {
      "type": "object",
      "properties": {
        "supplierName": {
          "type": "string",
          "example": "Premium Fabrics Inc."
        },
        "email": {
          "type": "string",
          "example": "supplier@fabrics.com"
        },
        "phone": {
          "type": "string",
          "example": "+1-555-123-4567"
        }
      }
    }
